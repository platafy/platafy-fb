{
    "manifest_version": 3,
    "name": "PLATAFY FB",
    "version": "1.0",
    "version_name": "v1.0",
    "description": "Automação inteligente para Facebook — poste em grupos, extraia membros e envie mensagens com facilidade.",
    "homepage_url": "https://fb.platafy.com/",
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "tabs",
        "alarms",
        "notifications",
        "contextMenus"
    ],
    "host_permissions": [
        "https://www.facebook.com/*",
        "https://fb.platafy.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://www.facebook.com/*",
                "https://facebook.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/action16.png",
            "32": "icons/action32.png",
            "48": "icons/action48.png",
            "128": "icons/action128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "icons/*"
            ],
            "matches": [
                "https://www.facebook.com/*",
                "https://facebook.com/*"
            ]
        }
    ]
}
